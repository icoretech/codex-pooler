<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Codex Pooler" suffix={live_title_suffix(assigns[:page_title])}>
      {assigns[:page_title]}
    </.live_title>
    <link rel="icon" href={~p"/favicon.ico"} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={~p"/favicon-32x32.png"} />
    <link rel="icon" type="image/png" sizes="16x16" href={~p"/favicon-16x16.png"} />
    <link rel="apple-touch-icon" sizes="180x180" href={~p"/apple-touch-icon.png"} />
    <link rel="manifest" href={~p"/site.webmanifest"} />
    <meta name="theme-color" content="#ff9900" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        // Every touch of the store is guarded, including the first: localStorage
        // is a global accessor that throws outright where storage is denied, so
        // an unguarded read here would kill this script before it registers its
        // listeners — no theme applied and a dead theme switcher, rather than a
        // preference that is simply not remembered.
        const remember = (theme) => {
          try {
            if (theme === "system") {
              localStorage.removeItem("phx:theme");
            } else {
              localStorage.setItem("phx:theme", theme);
            }
          } catch {
            /* the theme still applies to this page; it just is not kept */
          }
        };
        const setTheme = (theme) => {
          remember(theme);

          if (theme === "system") {
            document.documentElement.removeAttribute("data-theme");
          } else {
            document.documentElement.setAttribute("data-theme", theme);
          }
        };
        const storedTheme = (() => {
          try {
            return localStorage.getItem("phx:theme");
          } catch {
            return null;
          }
        })();
        const isObservatoryPath = window.location.pathname === "/observatory" ||
          window.location.pathname.startsWith("/observatory/");
        if (!document.documentElement.hasAttribute("data-theme")) {
          if (storedTheme) {
            setTheme(storedTheme);
          } else if (isObservatoryPath) {
            document.documentElement.setAttribute("data-theme", "dark");
          } else {
            setTheme("system");
          }
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));
      })();
    </script>
    <script>
      // Same reason as the theme above: the live-updates toggle would otherwise
      // paint its resting icon and be corrected once the socket connects and the
      // hook mounts — around 100ms locally, longer on a real link, and visibly
      // wrong for anyone who had paused. Reading it here, synchronously, means
      // the first paint is already right. If this never runs the attribute is
      // absent and the CSS falls back to "live", which is the safe reading.
      (() => {
        try {
          const paused = sessionStorage.getItem("codexPooler.liveUpdatesPaused") === "true";
          document.documentElement.setAttribute("data-live-updates-paused", paused ? "true" : "false");
        } catch {
          /* storage can be refused; the fallback is the resting state */
        }
      })();
    </script>
  </head>
  <body>
    {@inner_content}
    <.impeccable_live_script />
  </body>
</html>
