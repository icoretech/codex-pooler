<Layouts.app flash={@flash} locale={@locale} locale_preference={@locale_preference} auth_surface>
  <section
    id="observatory-login"
    class="mx-auto grid min-h-[calc(100svh-10rem)] w-full max-w-4xl items-center px-4 py-10"
  >
    <div class="grid overflow-hidden rounded-box border border-base-300 bg-base-100 shadow-sm lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
      <div class="grid content-between gap-8 border-b border-base-300 bg-base-200/60 p-6 sm:p-8 lg:border-b-0 lg:border-r">
        <div class="space-y-4">
          <Layouts.public_logo id="observatory-login-logo" />
          <div class="space-y-3">
            <div class="flex items-center gap-3">
              <span
                id="observatory-login-mark"
                aria-hidden="true"
                class="grid size-10 shrink-0 place-items-center rounded-lg bg-primary/15 text-primary sm:size-11"
              >
                <.icon name="hero-sparkles" class="size-6" />
              </span>
              <h1 class="text-3xl font-bold text-base-content sm:text-4xl">
                {gettext("Observatory")}
              </h1>
            </div>
            <p class="max-w-md text-sm leading-6 text-base-content/70">
              {gettext("Your access key at a glance: a read-only view of what it sends through Codex Pooler, with success rate, cache hits, speed and cost.")}
            </p>
          </div>
        </div>
      </div>

      <div class="p-6 sm:p-8">
        <p
          :if={@error}
          id="observatory-login-error"
          class="mb-5 rounded border border-error/30 bg-error/10 px-3 py-2 text-sm text-error"
        >
          {@error}
        </p>

        <.form
          for={@form}
          id="observatory-login-form"
          action={~p"/observatory/login"}
          method="post"
          class="grid gap-5"
        >
          <.input
            field={@form[:api_key]}
            id="observatory-api-key"
            type="password"
            label={gettext("Access key")}
            autocomplete="current-password"
            required
          />
          <.button id="observatory-login-submit" class="btn btn-primary w-full gap-2 sm:w-fit">
            <span>{gettext("Continue")}</span>
            <.icon name="hero-arrow-right" class="size-4" />
          </.button>
        </.form>
      </div>
    </div>
  </section>
</Layouts.app>
